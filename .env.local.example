# Supabase project settings
# 1. Go to https://supabase.com → New project
# 2. Settings → API → copy Project URL and anon/public key
# 3. Copy this file to .env.local and fill in your values
# 4. Run this SQL in the Supabase SQL editor:
#
# CREATE TABLE question_progress (
#   question_id  TEXT        NOT NULL,
#   user_id      UUID        REFERENCES auth.users(id) NOT NULL,
#   rehearsed    BOOLEAN     NOT NULL DEFAULT FALSE,
#   confidence   INTEGER     NOT NULL DEFAULT 0 CHECK (confidence BETWEEN 0 AND 5),
#   user_notes   TEXT        NOT NULL DEFAULT '',
#   updated_at   TIMESTAMPTZ NOT NULL DEFAULT NOW(),
#   PRIMARY KEY (question_id, user_id)
# );
# ALTER TABLE question_progress ENABLE ROW LEVEL SECURITY;
# CREATE POLICY "users own their rows" ON question_progress
#   USING (auth.uid() = user_id)
#   WITH CHECK (auth.uid() = user_id);
#
# 5. In Supabase Auth → Email → enable "Magic Link" and disable "Confirm email" requirement

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
